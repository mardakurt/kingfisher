node_modules
.next
out
dist
coverage
*.tsbuildinfo
next-env.d.ts
.env*
!.env.example
*.log
npm-debug.log*
.DS_Store

# Engine binaries are GPL-3.0 and ~7 MB; fetched by `npm run engine:install`.
/public/engine/

# Generated benchmark collections and browser-automation captures. Both are
# reproducible from scripts/ and neither belongs in review.
public/bench/
.playwright-mcp/
playwright-report/
# `test-results/` plus the "test-results 2" copies a file manager leaves behind
# when a run is interrupted. Two of those were sitting in the tree.
test-results*/
public/brandlab/

# Screenshots dropped at the repository root by browser tooling. Scoped to the
# root on purpose: the app's own icons are product assets and are committed.
/*.png

# Engine binaries and neural weights. GPL, 25-115 MB, and belonging to their
# own projects; `npm run engines:install` fetches them on demand.
engines/
companion/data/
# `npm run engines:verify` installs the whole fleet to interrogate it.
.engine-fleet/
.archive-cache/
.packs/

# The real-scale benchmark database. Tens of gigabytes; rebuilt by
# `node scripts/bench-real-scale.mjs`. The one that was here was eleven.
.real-scale/

# The compaction benchmark's collection, when it is pointed inside the tree.
# Rebuilt by `npm run bench:compaction`; the measured one was 4.96 GB after
# migrating and 10.54 GB at its widest, and its numbers are in
# `docs/performance/phase-18-storage.md` where they do not take up a disk.
.compaction/
kf-compaction-run/

# The desktop shell's own install, the web bundle it packs, and the
# applications electron-builder writes. All three are reproducible from
# `npm run desktop:dist`; the .app alone is 300 MB.
desktop/node_modules/
desktop/web/
desktop/dist/
# electron-builder refuses an output path with an `&` in it, so a checkout
# under one lands here instead; `desktop/scripts/build.mjs` explains it.


# Engine sources checked out and binaries produced by `npm run engines:build`.
# Reproducible from an exact upstream tag; the provenance record is what gets
# kept, in the workflow artifact.
.engine-build/
# Sanitised copies of `public/engine/*.json`, written at packaging time with
# the build machine's absolute paths removed. Generated by
# `scripts/build-desktop-web.mjs`; never edited by hand.
desktop/resources/
.vercel

# Project-local cache fallback when the user-cache directory is not
# writable. `scripts/cache-paths.mjs` documents the resolution order.
.cache/

# Large generated output that the brief explicitly tells developers
# to keep outside the source tree. A reference-pack build candidate
# (hundreds of MB before compression) is a build input, not source.
kingfisher-data/
security-scan-report.json
