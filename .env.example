# Kingfisher accounts and cloud sync (optional).
#
# Without these two variables Kingfisher is the local-first application it has
# always been, and the account pages say accounts are not set up in this build.
# Both values are public by design: the publishable key grants nothing without
# a signed-in user, and Row Level Security limits a user to their own rows
# (supabase/migrations/). Copy to .env.local for development; set the same two
# in the Vercel project for production. docs/operations/supabase-setup.md has
# every step.
#
# NEVER put the service_role or sb_secret_ key in any NEXT_PUBLIC_ variable.
# Kingfisher refuses to start the account service with one.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
