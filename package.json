{
  "name": "kingfisher",
  "version": "0.1.0",
  "private": true,
  "description": "Kingfisher \u2014 a chess research workspace for strong players.",
  "scripts": {
    "dev": "next dev --port 3210",
    "build": "next build",
    "start": "next start --port 3210",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run engine:install && playwright test",
    "test:e2e:ui": "npm run engine:install && playwright test --ui",
    "test:e2e:visual": "npm run engine:install && playwright test e2e/visual.spec.ts",
    "visual:baselines": "npm run engine:install && playwright test e2e/visual.spec.ts --update-snapshots",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "engine:install": "node scripts/install-engine.mjs",
    "companion": "node companion/src/server.mjs",
    "engines:install": "node scripts/install-engines.mjs",
    "tablebase:install": "node scripts/install-tablebase.mjs",
    "openings:build": "node scripts/build-opening-index.mjs && prettier --write src/theory/opening-index.generated.ts",
    "bench:sqlite": "node scripts/bench-sqlite.mjs",
    "bench:engines": "node scripts/bench-engines.mjs",
    "bench:evidence": "node scripts/bench-evidence.mjs",
    "bench:pgn": "node scripts/bench-pgn.mjs",
    "bench:aggregates": "node scripts/bench-aggregates.mjs",
    "bench:rules": "node scripts/bench-rules-experiment.mjs",
    "bench:preparation": "node scripts/bench-preparation.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "bundle:report": "node scripts/bundle-report.mjs",
    "smoke:lichess": "node scripts/smoke-lichess.mjs",
    "bench:player-search": "node scripts/bench-player-search.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "chess.js": "^1.4.0",
    "next": "16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
