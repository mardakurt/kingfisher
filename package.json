{
  "name": "kingfisher",
  "version": "0.1.0",
  "private": true,
  "description": "Kingfisher \u2014 a chess research workspace for strong players.",
  "scripts": {
    "dev": "next dev --port 3210",
    "build": "next build",
    "start": "next start --port 3210",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "engine:install": "node scripts/install-engine.mjs",
    "companion": "node companion/src/server.mjs",
    "engines:install": "node scripts/install-engines.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "chess.js": "^1.4.0",
    "next": "16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
