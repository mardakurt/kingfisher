{
  "name": "kingfisher",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "description": "Kingfisher — a chess research workspace for strong players.",
  "scripts": {
    "dev": "next dev --port 3210",
    "build": "next build",
    "start": "next start --port 3210",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run engine:install && playwright test",
    "test:e2e:ui": "npm run engine:install && playwright test --ui",
    "test:e2e:visual": "npm run engine:install && playwright test e2e/visual.spec.ts",
    "visual:baselines": "npm run engine:install && UPDATE_VISUAL_BASELINES=1 playwright test e2e/visual.spec.ts --update-snapshots",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "engine:install": "node scripts/install-engine.mjs",
    "companion": "node companion/src/server.mjs",
    "desktop": "npm run desktop:build:web && npm --prefix desktop start",
    "desktop:install": "npm --prefix desktop install",
    "desktop:build:web": "node scripts/build-desktop-web.mjs",
    "desktop:pack": "npm run desktop:build:web && npm --prefix desktop run pack",
    "desktop:dist": "npm run desktop:build:web && npm --prefix desktop run dist",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:restart": "node scripts/desktop-restart.mjs",
    "desktop:suspend": "node scripts/desktop-suspend.mjs",
    "desktop:upgrade": "node scripts/desktop-upgrade.mjs",
    "desktop:chrome": "node scripts/desktop-chrome.mjs",
    "desktop:engines": "node scripts/desktop-engines.mjs",
    "engines:install": "node scripts/install-engines.mjs",
    "tablebase:install": "node scripts/install-tablebase.mjs",
    "openings:build": "node scripts/build-opening-index.mjs && prettier --write src/theory/opening-index.generated.ts",
    "bench:sqlite": "node scripts/bench-sqlite.mjs",
    "bench:collections": "node scripts/bench-collections.mjs",
    "bench:engines": "node scripts/bench-engines.mjs",
    "bench:evidence": "node scripts/bench-evidence.mjs",
    "bench:pgn": "node scripts/bench-pgn.mjs",
    "bench:aggregates": "node scripts/bench-aggregates.mjs",
    "bench:rules": "node scripts/bench-rules-experiment.mjs",
    "bench:compaction": "node scripts/bench-compaction.mjs",
    "bench:claim-search": "node scripts/bench-claim-search.mjs",
    "bench:preparation": "node scripts/bench-preparation.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "bundle:report": "node scripts/bundle-report.mjs",
    "smoke:lichess": "node scripts/smoke-lichess.mjs",
    "bench:player-search": "node scripts/bench-player-search.mjs",
    "bench:opening-depth": "node scripts/bench-opening-depth.mjs",
    "bench:explorer-depth": "node scripts/bench-explorer-depth.mjs",
    "engines:digests": "node scripts/record-engine-digests.mjs",
    "engines:verify": "node scripts/verify-engine-fleet.mjs",
    "engines:qualify": "node scripts/qualify-engines.mjs",
    "engines:lab": "node scripts/engine-lab.mjs",
    "bench:engine-concurrency": "node scripts/bench-engine-concurrency.mjs",
    "engines:build": "node scripts/build-engine.mjs",
    "reference:build": "node scripts/build-reference-pack.mjs",
    "polyglot:constants": "node scripts/build-polyglot-constants.mjs && prettier --write src/book/polyglot-constants.generated.ts",
    "pieces:measure": "node scripts/measure-piece-scale.mjs",
    "desktop:field": "node scripts/desktop-field.mjs",
    "desktop:soak": "playwright test --config playwright.packaged.config.ts",
    "release:verify": "node scripts/release-verify.mjs",
    "release:verify:full": "node scripts/release-verify-full.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "public:check": "node scripts/public-link-check.mjs",
    "publish:site": "node scripts/publish-site.mjs",
    "publish:data": "node scripts/publish-data.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "deploy:vercel": "node scripts/vercel-deploy.mjs",
    "size:report": "node scripts/size-report.mjs",
    "size:check": "node scripts/size-report.mjs --top=20",
    "clean:dev": "rm -rf .next test-results playwright-report .engine-fleet .packs && echo 'cleaned: .next, test-results, playwright-report, .engine-fleet, .packs (rerun npm install / build to repopulate)'",
    "data:cache:report": "du -sh .archive-cache .packs 2>/dev/null || echo 'no cache'",
    "data:cache:prune": "rm -rf .archive-cache .packs .engine-build && echo 'pruned reproducible cache (engines re-fetch via npm run engines:install)'"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "chess.js": "^1.4.0",
    "next": "16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
